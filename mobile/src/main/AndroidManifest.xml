<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Scanning a subscription QR code. Asked for when the scanner opens. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- CAMERA would otherwise imply both features are required to install
         the app at all; the scanner falls back to a picked image instead. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <application
        android:name="io.github.madeye.meow.App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Material3.DayNight.NoActionBar">
        <!-- Firebase Analytics opt-in is per buildType (release=true, playRelease=false). -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="${analyticsEnabled}" />
        <activity
            android:name="io.github.madeye.meow.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <!-- singleTask: a link tapped in a browser or chat app must reach
                 the one running instance (onNewIntent), not stack a second
                 copy of the app into the caller's task. -->
            <!-- Long-pressing the Quick Settings tile opens the app. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- One-tap subscription import: clash://install-config?url=…, and
                 the clashmeta:// spelling some panels emit. Scoped to the
                 install-config host so other clash:// links stay with whichever
                 client handles them. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="clash" />
                <data android:scheme="clashmeta" />
                <data android:host="install-config" />
            </intent-filter>
        </activity>

        <!-- Subscription QR scanner; started for a result by the Subscribe tab. -->
        <activity
            android:name="io.github.madeye.meow.ui.screens.subscribe.SubscriptionScanActivity"
            android:exported="false" />
        <!-- Shares the subscription QR image; see res/xml/file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Quick Settings VPN toggle. It runs in :vpn, beside the service it
             toggles, to read the service state in-process; see VpnTileService.
             Only the system can bind it (BIND_QUICK_SETTINGS_TILE). -->
        <service
            android:name="io.github.madeye.meow.tile.VpnTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:process=":vpn">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
        <!-- Finishes a tile start that needs an Activity (VPN consent, or a
             refused background start). Not exported: only the tile's
             PendingIntent may launch it. Own task, out of recents, so it
             leaves nothing behind. -->
        <activity
            android:name="io.github.madeye.meow.tile.TileConnectActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>

</manifest>
